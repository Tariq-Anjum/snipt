<?xml version="1.0" encoding="utf-8"?>
<!--
  Default-SMS app surface (android.provider.Telephony "Creating an SMS app").
  Merged into the app manifest by AGP. Exported flags:
  - receivers/service the system calls are exported and guarded by the
    system-only permission the platform holds (BROADCAST_SMS,
    BROADCAST_WAP_PUSH, SEND_RESPOND_VIA_MESSAGE);
  - the compose trampoline is exported (other apps start SENDTO/SEND);
  - our own status / notification-action receivers are not exported.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Minimal set: receive/read/send SMS, WAP push + MMS download (S15:
         downloadMultimediaMessage needs RECEIVE_MMS; the NotifyResp ack via
         sendMultimediaMessage needs SEND_SMS - MmsServiceBroker),
         SIM list for Dual-SIM (getActiveSubscriptionInfoList needs
         READ_PHONE_STATE), notifications (API 33+). -->
    <uses-permission android:name="android.permission.RECEIVE_SMS" />
    <uses-permission android:name="android.permission.READ_SMS" />
    <uses-permission android:name="android.permission.SEND_SMS" />
    <uses-permission android:name="android.permission.RECEIVE_MMS" />
    <uses-permission android:name="android.permission.RECEIVE_WAP_PUSH" />
    <uses-permission android:name="android.permission.READ_PHONE_STATE" />
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />

    <uses-feature android:name="android.hardware.telephony" android:required="true" />

    <application>
        <receiver
            android:name="app.snipt.telephony.SmsDeliverReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_SMS">
            <intent-filter>
                <action android:name="android.provider.Telephony.SMS_DELIVER" />
            </intent-filter>
        </receiver>

        <receiver
            android:name="app.snipt.telephony.MmsWapPushReceiver"
            android:exported="true"
            android:permission="android.permission.BROADCAST_WAP_PUSH">
            <intent-filter>
                <action android:name="android.provider.Telephony.WAP_PUSH_DELIVER" />
                <data android:mimeType="application/vnd.wap.mms-message" />
            </intent-filter>
        </receiver>

        <service
            android:name="app.snipt.telephony.RespondViaMessageService"
            android:exported="true"
            android:permission="android.permission.SEND_RESPOND_VIA_MESSAGE">
            <intent-filter>
                <action android:name="android.intent.action.RESPOND_VIA_MESSAGE" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
        </service>

        <activity
            android:name="app.snipt.telephony.ComposeTrampolineActivity"
            android:exported="true"
            android:excludeFromRecents="true"
            android:noHistory="true"
            android:theme="@android:style/Theme.Translucent.NoTitleBar">
            <intent-filter>
                <action android:name="android.intent.action.SENDTO" />
                <action android:name="android.intent.action.VIEW" />
                <category android:name="android.intent.category.DEFAULT" />
                <category android:name="android.intent.category.BROWSABLE" />
                <data android:scheme="sms" />
                <data android:scheme="smsto" />
                <data android:scheme="mms" />
                <data android:scheme="mmsto" />
            </intent-filter>
            <!-- "Share text via SMS" (no recipient). -->
            <intent-filter>
                <action android:name="android.intent.action.SEND" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
        </activity>

        <receiver
            android:name="app.snipt.telephony.SmsStatusReceiver"
            android:exported="false" />

        <receiver
            android:name="app.snipt.telephony.NotificationActionReceiver"
            android:exported="false" />

        <!-- S15: result of downloadMultimediaMessage / sendMultimediaMessage
             (our own explicit PendingIntents only). -->
        <receiver
            android:name="app.snipt.telephony.MmsDownloadReceiver"
            android:exported="false" />

        <!-- S15: the platform MmsService writes the downloaded PDU through a
             content URI; MmsServiceBroker grants the phone process access on
             our behalf, so the provider must allow URI grants. Not exported;
             only cacheDir/snipt-mms/ is mapped. -->
        <provider
            android:name="app.snipt.telephony.SniptMmsFileProvider"
            android:authorities="${applicationId}.snipt.mms"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/snipt_mms_paths" />
        </provider>
    </application>
</manifest>
