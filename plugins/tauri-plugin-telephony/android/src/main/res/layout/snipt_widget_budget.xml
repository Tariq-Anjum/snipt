<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snipt_b_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/snipt_widget_glass"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/snipt_b_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="@string/snipt_widget_budget"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/snipt_b_pct"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp"
            android:textStyle="bold" />
    </LinearLayout>
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:baselineAligned="true"
        android:orientation="horizontal">
        <TextView
            android:id="@+id/snipt_b_spent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/snipt_w_text"
            android:textSize="24sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/snipt_b_of"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="6dp"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp" />
    </LinearLayout>
    <ProgressBar
        android:id="@+id/snipt_b_bar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="7dp"
        android:layout_marginTop="6dp"
        android:max="1000"
        android:progressDrawable="@drawable/snipt_widget_progress" />
    <TextView
        android:id="@+id/snipt_b_left"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:maxLines="1"
        android:textColor="@color/snipt_w_text2"
        android:textSize="11sp" />
    <LinearLayout
        android:id="@+id/snipt_b_cat0"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_b_cat0_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/snipt_b_cat0_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/snipt_b_cat0_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:max="1000"
            android:progressDrawable="@drawable/snipt_widget_progress" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/snipt_b_cat1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_b_cat1_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/snipt_b_cat1_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/snipt_b_cat1_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:max="1000"
            android:progressDrawable="@drawable/snipt_widget_progress" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/snipt_b_cat2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_b_cat2_name"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="11sp" />
            <TextView
                android:id="@+id/snipt_b_cat2_amt"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <ProgressBar
            android:id="@+id/snipt_b_cat2_bar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="match_parent"
            android:layout_height="4dp"
            android:layout_marginTop="2dp"
            android:max="1000"
            android:progressDrawable="@drawable/snipt_widget_progress" />
    </LinearLayout>
</LinearLayout>
