<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/snipt_w_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/snipt_widget_glass"
    android:orientation="vertical"
    android:padding="14dp">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">
        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Snipt"
            android:textColor="@color/snipt_w_text"
            android:textSize="15sp"
            android:textStyle="bold" />
        <TextView
            android:id="@+id/snipt_w_unread"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/snipt_widget_pill"
            android:minWidth="22dp"
            android:gravity="center"
            android:paddingStart="7dp"
            android:paddingEnd="7dp"
            android:paddingTop="1dp"
            android:paddingBottom="1dp"
            android:textColor="#FFFFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
    <TextView
        android:id="@+id/snipt_w_empty"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center"
        android:text="@string/snipt_widget_empty"
        android:textColor="@color/snipt_w_text2"
        android:textSize="12sp" />
    <LinearLayout
        android:id="@+id/snipt_w_row0"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_w_title0"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/snipt_w_time0"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/snipt_w_body0"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/snipt_w_row1"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_w_title1"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/snipt_w_time1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/snipt_w_body1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp" />
    </LinearLayout>
    <LinearLayout
        android:id="@+id/snipt_w_row2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:orientation="vertical">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">
            <TextView
                android:id="@+id/snipt_w_title2"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:ellipsize="end"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text"
                android:textSize="13sp"
                android:textStyle="bold" />
            <TextView
                android:id="@+id/snipt_w_time2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:maxLines="1"
                android:textColor="@color/snipt_w_text2"
                android:textSize="11sp" />
        </LinearLayout>
        <TextView
            android:id="@+id/snipt_w_body2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:textColor="@color/snipt_w_text2"
            android:textSize="12sp" />
    </LinearLayout>
</LinearLayout>
