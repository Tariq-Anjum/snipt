<?xml version="1.0" encoding="utf-8"?>
<!--
  DEBUG BUILDS ONLY (src/debug source set of the plugin library; never in
  release). S15 test entry: feeds locally supplied MMS PDUs through the real
  receive path, because an emulator cannot deliver carrier MMS. Guarded by
  android.permission.DUMP, which the adb shell holds and third-party apps
  cannot obtain.
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <receiver
            android:name="app.snipt.telephony.MmsDebugReceiver"
            android:exported="true"
            android:permission="android.permission.DUMP">
            <intent-filter>
                <action android:name="app.snipt.sms.DEBUG_MMS" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
