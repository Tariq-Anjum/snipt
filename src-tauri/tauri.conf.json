{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Snipt",
  "mainBinaryName": "snipt",
  "version": "0.1.0",
  "identifier": "app.snipt.sms",
  "build": {
    "frontendDist": "../web-dist",
    "devUrl": "http://localhost:3000",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "Snipt",
        "width": 1100,
        "height": 760,
        "resizable": true,
        "fullscreen": false,
        "label": "main",
        "minWidth": 360,
        "minHeight": 480
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": [
      "deb"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "android": {
      "minSdkVersion": 29
    }
  }
}
